@model IEnumerable<MoviesAdmin.Models.AudienceRating>

@{
    ViewData["Title"] = "Audience Ratings";
}

<h1>MPAA ratings</h1>
<p class="text-muted">Manage the different MPAA ratings available for movies.</p>

<p>
    <a asp-action="Create" class="btn btn-success">Add New Rating</a>
</p>
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>
                Ratings
            </th>
            <th>
                
            </th>
            <th>

            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Title)
            </td>
            <td>
                @Html.DisplayFor(model => item.Movies)
            </td>
            <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary me-2 mb-1">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info me-2 mb-1">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger me-1 mb-1">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
