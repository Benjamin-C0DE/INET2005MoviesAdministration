@model IEnumerable<MoviesAdmin.Models.Genre>

@{
    ViewData["Title"] = "Manage Genres";
}

<h1>Genres</h1>
<p >Manage the different genres available for movies.</p>

<p>
    <a asp-action="Create" class="btn btn-success">Add New Genre</a>
</p>
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>
                Genres
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Title)
            </td>
            <td>
                @Html.DisplayFor(model => item.Movies)
            </td>
            <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary me-2 mb-1">Edit</a> 
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info me-2 mb-1">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger me-1 mb-1">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
