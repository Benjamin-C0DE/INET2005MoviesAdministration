@model MoviesAdmin.Models.CriticReview

@{
    ViewData["Title"] = "Review Details";
}

<h1> Review Details</h1>

<div>
    <hr />
    <dl>
        <dt class = "col-sm-2">
            Movie Title
        </dt>
        <dd class = "col-sm-10">
            @Model.Movie?.Title
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Rating)
        </dt>
        <dd class = "col-sm-10">
            @Model.Rating / 5
        </dd>
        <dt class = "col-sm-2">
            Review Status
        </dt>
        <dd class = "col-sm-10">
            @if (Model.IsPublished)
            {
                <span class="text-success">Published</span>   
            }
            else
            {
                <span class="text-warning">Draft</span>
            }
        </dd>
        <dt class = "col-sm-2">
            Dated Posted
        </dt>
        <dd class = "col-sm-10">
            @Model.CreatedDate.ToShortDateString()
        </dd>
        <dt class = "col-sm-2">
            Review
        </dt>
        <dd class = "col-sm-10">
            <div class="card shadow-sm">
                <div class="card-body review-text">
					@Model.Description
                </div>
            </div>
        </dd>

    </dl>
</div>
<div>
	<a asp-action="Index" class="btn btn-success mb-2">Back to List</a>
</div>
