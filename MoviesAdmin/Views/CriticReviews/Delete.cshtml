@model MoviesAdmin.Models.CriticReview

@{
    ViewData["Title"] = "Delete Review";
}

<h1>Delete Review</h1>

<h4>Are you sure you want to delete this?</h4>
<div>
    <dl class="row">
        <dt class="col-sm-2">
            Movie Title
        </dt>
        <dd class="col-sm-10">
            @Model.Movie?.Title
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Rating)
        </dt>
        <dd class="col-sm-10">
            @Model.Rating / 5
        </dd>
        <dt class="col-sm-2">
            Review Status
        </dt>
        <dd class="col-sm-10">
            @if (Model.IsPublished)
            {
                <span class="text-success">Published</span>
            }
            else
            {
                <span class="text-warning">Published</span>
            }
        </dd>
        <dt class="col-sm-2">
            Dated Posted
        </dt>
        <dd class="col-sm-10">
            @Model.CreatedDate.ToShortDateString()
        </dd>
        <dt class="col-sm-2">
            Review
        </dt>
        <dd class="col-sm-10">
            @Model.Description
        </dd>
    </dl>
</div>
<div>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger mb-2 me-2" />
        <a asp-action="Index" class="btn btn-success mb-2">Back to List</a>
    </form>
</div>
