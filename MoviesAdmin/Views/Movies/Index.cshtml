@model IEnumerable<MoviesAdmin.Models.Movie>

@{
    ViewData["Title"] = "Movies Table";
}

<h1 class="mb-3">Movie Administration</h1>
<p class="text-muted">Manage your movie database - add, edit, or remove entries.</p>


<p>
    <a asp-action="Create" class="btn btn-success">Add New Movie</a>
</p>
<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
		    <tr>
				<th>Poster</th> <!--Poster column -->
                <th>@Html.DisplayNameFor(model => model.Title)</th>
			    <th>@Html.DisplayNameFor(model => model.Genre)</th>
                <th>@Html.DisplayNameFor(model => model.AudienceRating) </th>
			    <th>Runtime (Min)</th>
			    <th> Release Date</th>
            
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) 
            {
                <tr>
                    <td>
                        <!-- Display poster image if available-->
                        @if (!string.IsNullOrEmpty(item.PosterUrl))
                        {
                            <img src="@item.PosterUrl" class="img-fluid" width="80" /> <!-- Display poster image with a width of 80 pixels -->
                        }
                    </td>

	                <td>@Html.DisplayFor(model => item.Title)</td>
                    <td>@Html.DisplayFor(model => item.Genre.Title)</td>
                    <td>@Html.DisplayFor(model => item.AudienceRating.Title)</td>
                    <td>@Html.DisplayFor(model => item.RuntimeMinutes)</td>
                    <td>@Html.DisplayFor(model => item.ReleaseDate)</td>

                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary me-2 mb-1">Edit</a>        <!--Edit button using Bootstrap classes for styling -->
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info me-2 mb-1">Details</a>     <!-- Details button using Bootstrap classes for styling -->
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger mb-1">Delete</a>     <!-- Delete button using Bootstrap classes for styling -->
                        </td>
                        <!--me-1/margin-end (right side) & -->
                        <!--mb-1/margin-bottom (helps mobile stacking)-->
                </tr>
            }
        </tbody>
    </table>
</div>
</>
