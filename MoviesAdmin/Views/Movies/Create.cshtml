@model MoviesAdmin.Models.Movie

@{
    ViewData["Title"] = "Add a Movie";
}

<h1>Movie</h1>

<h4>create new Movie Data</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Title" class="control-label mb-2"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Synopsis" class="control-label mb-2"></label>
                <input asp-for="Synopsis" class="form-control" />
                <span asp-validation-for="Synopsis" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="GenreId" class="control-label mb-2">Genre</label>
                <select asp-for="GenreId" class="form-control" asp-items="ViewBag.GenreId"></select> <!--Genre Listed a a dropp down-->
                <span asp-validation-for="GenreId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="AudienceRatingId" class="control-label mb-2">Rating</label>
                <select asp-for="AudienceRatingId" class="form-control" asp-items="ViewBag.AudienceRatingId"></select> <!-- Dropdown, updated using the AudienceRatingId -->
                <span asp-validation-for="AudienceRatingId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="RuntimeMinutes" class="control-label mb-2">Runtime (Min)</label>
                <input asp-for="RuntimeMinutes" class="form-control" min="1" /> <!-- Prevents negative runtime values by enforcing a minimum of 1 minute -->
                <span asp-validation-for="RuntimeMinutes" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="ReleaseDate" class="control-label mb-3">Release Date</label>
                <input asp-for="ReleaseDate" class="form-control" /> <!-- Date input for movie release date (validated to not be in the future) -->
                <span asp-validation-for="ReleaseDate" class="text-danger"></span>
            </div>
            <!--For posters-->
            <div class="form-group mb-3">
                <label class="mb-2">Poster</label>
                <input type="file" name="posterFile" class="form-control"/>
            </div>
            
            <div class="form-group mb-3">
                <input type="submit" value="Create" class="btn btn-primary"/>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index" class="btn btn-success">Back to List</a>
</div>
