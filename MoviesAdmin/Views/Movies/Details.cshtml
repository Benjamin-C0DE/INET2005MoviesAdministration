@model MoviesAdmin.Models.Movie

@{
    ViewData["Title"] = "Movie Details";
}

<h1>Details</h1>

<div class="container">
    <h4>Movie</h4>
    <hr />
    <dl class="row">
        <!-- Add poster -->
        <dd class ="col-sm-10">
            @if (!string.IsNullOrEmpty(Model.PosterUrl))
            {
                <img src="@Model.PosterUrl" class="img-fluid" width="300" />
            }
        </dd>
    </dl>

    <dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Title)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Title)
        </dd>
   
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Synopsis)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Synopsis)
        </dd>
    
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Genre)
        </dt>
        <dd class = "col-sm-10">
            @Model.Genre?.Title <!--Display Genre on details screen-->
        </dd>
    
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.AudienceRating)
        </dt>
        <dd class = "col-sm-10">
            @Model.AudienceRating?.Title <!--Display Rating on details screen-->
        </dd>
    
        <dt class = "col-sm-2">
            Runtime (Min)
        
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.RuntimeMinutes)
        </dd>
    
        <dt class = "col-sm-2">
            Release Date
        
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ReleaseDate)
        </dd>
    </dl>

    <div>
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-pr">Edit</a> |
        <a asp-action="Index" class="btn btn-success">Back to List</a>
    </div>
</div>