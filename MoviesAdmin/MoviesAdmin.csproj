    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>bff7f594-e8da-423a-b92c-26b1133f8d32</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
